# Keep this file as a template. Put real secrets ONLY in your local .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Comma-separated server allowlist. A single DISCORD_GUILD_ID remains supported.
DISCORD_GUILD_IDS=
FAUCET_PRIVATE_KEY=

# FaucetBot Supabase project. Use a server secret key (or legacy service_role key).
# Never use the publishable/anon key and never paste secrets into Discord or chat.
SUPABASE_URL=https://pypehbsuhuhnutxkphyf.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_TIMEOUT_MS=15000

# ITL Testnet (native tITL, 18 decimals)
RPC_BASE_URL=https://evm-rpc.test-net.interlinklabs.ai/v1
CHAIN_ID=19042026
TOKEN_SYMBOL=tITL
EXPLORER_URL=https://explorer.test-net.interlinklabs.ai
SIWE_DOMAIN=interlinklabs.ai

# First-run defaults. Subsequent Discord settings persist in Supabase.
DEFAULT_AMOUNT=0.1
DEFAULT_COOLDOWN_HOURS=6
MAX_PAYOUT_AMOUNT=10
MAX_BATCH_TOTAL=100
MAX_DAILY_TOTAL=1000
MAX_BATCH_ROWS=100
AUTO_CLAIM=true

# Transactions always use EIP-1559; amounts below are gas safety limits.
CONFIRMATIONS=3
MAX_FEE_PER_GAS_GWEI=100
MAX_GAS_LIMIT=100000
RPC_TIMEOUT_MS=15000
POLL_INTERVAL_MS=5000

# Bound request checks during bursts; accepted payouts stay in the database queue.
REQUEST_CONCURRENCY=8
REQUEST_QUEUE_LIMIT=100
REQUEST_QUEUE_WAIT_MS=60000

# Render Web Services provide PORT automatically; leave it unset for a Background Worker.
# PORT=10000
# Render also sets RENDER_EXTERNAL_URL. Optional override for the idle keep-alive ping:
# KEEP_ALIVE_URL=https://your-service.onrender.com
# KEEP_ALIVE_MS=480000
